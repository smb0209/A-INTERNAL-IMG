# /etc/a-signage.env — a-signage.service 와 a-signage-sync.service 가 같이 읽는다. 비밀값 없음.
PORT=8080
DATA_DIR=/var/lib/a-signage
# 채널 = 주소 첫 경로. 이름:구글드라이브공개폴더ID 를 쉼표로 (폴더 ID = 공유 링크 .../folders/<이 부분>).
#   tv.amartyyc.com/gompyo 또는 gompyo.<도메인> -> gompyo 채널 (호스트 첫 이름도 채널로 본다, MSX 는 / 를 못 침). 둘 다 아니면(IP:8080, tv.amartyyc.com) 첫 채널.
CHANNELS=gompyo:11kXPXudaOqvPSf9TyLYalY2vieY0StpV,img:1ig4Q-vAs_Gh-PqlBCGkaeB2B0zO9kwrx
# 이미지 1장 노출(초), 크로스페이드(ms), 채널마다 남길 버전 폴더 수
DURATION=10
FADE_MS=2000
KEEP_VERSIONS=7
